  /**
   * 验证邀请码并激活 VIP（同步）。
   * @param code 用户输入的邀请码
   * @returns 空字符串 = 成功；否则为错误描述
   */
  static redeem(code: string): string {
    // 0. 已是 VIP → 无需邀请码
    if (VipManager.isVip()) {
      return '你已是会员，无需邀请码';
    }

    // 1. 预处理
    let raw = code.trim().toUpperCase();
    if (raw.startsWith(InviteCodeManager.PREFIX)) {
      raw = raw.substring(InviteCodeManager.PREFIX.length);
    }
    if (raw.length !== InviteCodeManager.CODE_LEN) {
      return '邀请码格式不正确';
    }
    if (!/^[A-Z0-9]+$/.test(raw)) {
      return '邀请码包含无效字符';
    }

    // 2. 白名单查重
    if (!InviteCodeManager.WHITELIST.has(raw)) {
      return '邀请码无效';
    }

    // 3. 已用检查
    if (InviteCodeManager.isUsed(raw)) {
      return '该邀请码已被使用';
    }

    // 4. 通过 → 标记已用 + 激活 VIP
    InviteCodeManager.markUsed(raw);
    VipManager.setVip(true);
    return '';
  }

  private static isUsed(code: string): boolean {
    const used: string = PreferencesUtil.getSync(InviteCodeManager.KEY_USED, '') as string;
    if (used === '') {
      return false;
    }
    return used.split(',').includes(code);
  }

  private static markUsed(code: string): void {
    const used: string = PreferencesUtil.getSync(InviteCodeManager.KEY_USED, '') as string;
    const arr = used === '' ? [] : used.split(',').filter((s: string) => s !== '');
    arr.push(code);
    PreferencesUtil.putSync(InviteCodeManager.KEY_USED, arr.join(','));
  }
