/**
 * ══════════════════════════════════════════════════════════════════════════════
 * 「公告」模块 · 内容真源 —— **改公告只改这一个文件**
 * ══════════════════════════════════════════════════════════════════════════════
 *
 * 模块目录（`entry/src/main/ets/componets/gonggao/`，三个文件各管一件事）：
 *   · `GonggaoData.ets`  ← 本文件：标题 / 正文 / 图片 / 按钮文字（**日常只改这里**）
 *   · `gonggaopage.ets`  ← 弹窗界面（排版、上下滚动、左右滑动）—— 一般不用动
 *   · `Gonggao.ets`      ← 什么时候弹 + 一键开关 —— 一般不用动
 *
 * ── 怎么加一条公告 ───────────────────────────────────────────────────────────
 * 在下面的 `GONGGAO_ITEMS` 数组里加一个 `{ ... }`：**一行 = 一页**，左右滑动切换。
 * 四个字段**全部必填**（没有内容就写空串 / 空数组，不要删字段）：
 *   · title  ：小标题，空串 `''` = 不显示
 *   · date   ：灰色小字（日期 / 版本号之类），空串 `''` = 不显示
 *   · body   ：正文，长文自动换行、上下滚动；换行写 `\n`
 *   · images ：配图数组，空数组 `[]` = 不显示
 *
 * ── 怎么放图片 ───────────────────────────────────────────────────────────────
 *   ① 推荐：图片放进 `entry/src/main/resources/rawfile/gonggao/`（目录可自建），
 *      然后写 `images: [$rawfile('gonggao/1.png')]`
 *   ② 或使用工程里已有的 media 资源：`images: [$r('app.media.icon')]`
 *   显示规则：宽度自动撑满弹窗内容区、高度按原图比例，圆角 12；多张按顺序纵向排列。
 *   ⚠️ `$rawfile('...')` 里的路径**写错会直接编译报错**（资源不存在），这比运行时空白好排查。
 *
 * ── 什么时候弹（判定全在 `Gonggao.ets`，这里是结论）──────────────────────────
 *   · 新装后第一次进入  → 弹；
 *   · 版本号（`AppScope/app.json5` 的 versionName）变了之后的第一次进入 → 弹；
 *   · **同一个版本号内只弹一次**，之后不再出现（即：只改文案、没升版本号 ⇒ 老用户看不到；
 *     调试请把 `Gonggao.IGNORE_FLAG_FOR_DEBUG` 临时置 `true`，或调 `Gonggao.debugReset()`）。
 *   · 把 `GONGGAO_ITEMS` 清成空数组 `[]` ⇒ 判定层直接判定"没内容"，永不弹（不发版也能关）。
 */
export interface GonggaoItem {
  /** 小标题（空串 = 不显示） */
  title: string;
  /** 灰色小字：日期 / 版本号等（空串 = 不显示） */
  date: string;
  /** 正文：长文自动换行 + 上下滚动，换行用 `\n` */
  body: string;
  /** 配图：`$rawfile('gonggao/x.png')` 或 `$r('app.media.x')`；空数组 = 不显示 */
  images: ResourceStr[];
  /**
   * 【可选】页面底部那颗可点按钮的文案，如 `'点击加群'`。
   * **不写 = 没有按钮**（`undefined` 与空串等价）。
   */
  actionText?: string;
  /**
   * 【可选】点了那颗按钮做什么，取值见下面的 `GONGGAO_ACTION_*`。
   * 写了 `actionText` 却没写 `action`（或写了不认识的值）= 按钮显示但点了没反应。
   */
  action?: string;
}

/**
 * 公告里可点按钮**支持的动作用值**（写别的值 = 按钮照常显示但点了没反应）。
 *
 *   `GONGGAO_ACTION_JOIN_GROUP` = 复用工程既有的「加入 QQ 群」链路：
 *      QQ 直接进群资料页 → 打不开就开浏览器 → 再失败提示群号。
 *      实现在 `common/utils/QqGroup.ets`，与「我的 → 设置 → 加入Q群」是**同一个函数**
 *      （按项目铁律"同一语义只允许一处实现"，换通道只改那一处）。
 *
 * 以后要加新动作（例如"去评分""打开某页面"）：这里加一个常量 +
 * 在 `Index.openGonggaoDialog()` 的 `onAction` 里加一个分支即可，**界面文件不用动**。
 */
export const GONGGAO_ACTION_JOIN_GROUP: string = 'joinGroup';

/** 弹窗顶部标题（想叫「更新公告」「版本说明」改这里） */
export const GONGGAO_DIALOG_TITLE: string = '公告';

/** 底部按钮文案 */
export const GONGGAO_OK_TEXT: string = '我知道了';

/**
 * ★ 公告内容（改这里）★ 一个对象 = 一页；数组顺序 = 左右滑动顺序。
 *
 * 下面两条是**可直接替换的示例**：第 1 条演示长文上下滚动，第 2 条演示配图 + 多页。
 */
export const GONGGAO_ITEMS: GonggaoItem[] = [
  {
    title: 'V3.1.0版本',
    date: '',
    body: '感谢您选择喵阅。\n\n' +
      '在过去的版本，我们的动画体验切换不平滑，甚至出现书签不同步的情况所以在此版本我们进行了优化\n\n' +
      '1.新增无动画模式，设置内动画切换按钮从点击变成一字排布，更方便使用\n' +
      '2.震动反馈、阅读器设置页滑块新增防误触锁定；亮度随系统/屏幕常亮增加确认\n' +
      '3.修复横滑、仿真模式下点击书签可能不能瞬时到达问题\n' +
      '4.完整的分组系统期待您的体验，优美的四宫格预览，最多十级子目录，新的批量管理系统，更多功能请自行探索\n' +
      '5.全架构链路的重构，性能体验的提升\n' +
      '\n\n',
    images: [],
    // 底下这颗按钮：不想要就把 actionText 改成 ''（或整行删掉）
    actionText: '点击加群',
    // 'joinGroup' = 复用「设置 → 加入Q群」的同一套链路（QQ → 浏览器 → 提示群号）
    action: GONGGAO_ACTION_JOIN_GROUP
  }
];
