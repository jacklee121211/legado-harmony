{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // AbilityStage（2026-10-02 新建）：接收配置变更，一镜到底官方库
    // ezCustomTransition.onConfigurationChanged() 依赖（见 entryability/MyAbilityStage.ets）
    "srcEntry": "./ets/entryability/MyAbilityStage.ets",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "usedScene": {
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "usedScene": {
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.VIBRATE",
        "usedScene": {
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GET_DONOTDISTURB_STATE",
        "usedScene": {
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GET_WIFI_INFO",
        "usedScene": {
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.PRIVACY_WINDOW",
        "usedScene": {
          "when": "inuse"
        }
      },
//       ⚠️【受限权限·已经启用】DLP_GET_HIDE_STATUS（防窥第2层：窥视检测/系统蒙层）。
//       受限开放权限（ACL）：Profile 里没有该权限白名单时**安装即失败**
//      （错误码 9568289 "grant request permissions failed"，2026-10-07 真机实测）。
//       等 AGC「申请受限权限」审批通过、重新出带 ACL 的 Profile 后，把下面这块
//       取消注释即可（运行时无需其它改动：AntiPeep.ets 对 201/801 已静默降级为仅第1层）。
//       参考实现：D:\Arkts\xiaowei（其 key/xiaoweiRelease.p7b 自带 ACL 所以能装）。现已申请通过已经开放2026.10.8 11：11
       {
         "name": "ohos.permission.DLP_GET_HIDE_STATUS",
         "reason": "$string:anti_peep_reason",
         "usedScene": {
           "abilities": ["EntryAbility"],
           "when": "inuse"
         }
       }
    ],
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "backgroundModes": [
          "audioPlayback",
          "dataTransfer"
        ],
        // 桌面静态快捷方式（快速听书 / 快速阅读）。
        // 官方 documentId `开发指南/开发基础知识/典型场景的开发指导/创建应用静态快捷方式/typical-scenario-configuration`：
        // 「在模块的 /resources/base/profile/ 目录下配置快捷方式的配置文件，如 shortcuts_config.json」
        // 「桌面展示快捷方式的数量有上限要求，最多展示 4 个。」
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    // ── 分享接收端（2026-09-30 回填，官方文档：
    //    开发指南/Share_Kit_分享服务/系统分享/目标应用处理分享内容/分享详情页处理分享内容/share-sec-panel）──
    // 接收方注册三要素（官方原文）：type: "share" + skills.actions: ohos.want.action.sendData
    // + uris 穷举支持的 utd。作用：华为分享面板/碰一碰（应用路由模式）把书送进本 App 沙箱
    // ⇒ ShareExtensionAbility(onSessionCreate) → systemShare.getSharedData → 导入书架。
    // utd 穷举：general.text（txt，官方示例同款）+ general.epub
    // （SDK @ohos.data.uniformTypeDescriptor.d.ts:409 EPUB = 'general.epub'）。
    "extensionAbilities": [
      {
        "name": "BookShareExtension",
        "srcEntry": "./ets/entryability/BookShareExtensionAbility.ets",
        "type": "share",
        "description": "$string:EntryAbility_desc",
        "exported": true,
        "label": "$string:EntryAbility_label",
        "icon": "$media:layered_image",
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 100
              },
              {
                "scheme": "file",
                "utd": "general.epub",
                "maxFileSupported": 100
              }
            ]
          }
        ]
      }
    ]
  }
}