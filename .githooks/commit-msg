#!/bin/sh
# ============================================================================
# .githooks/commit-msg —— 把「提交备注」同步成「版本号 + 更新日志」
#
# 启用（每个 clone 只需一次）：pwsh -File scripts/setup-git-hooks.ps1
#   （它执行 git config core.hooksPath .githooks —— 钩子随仓库走，所有 agent 都生效）
#
# 规范：**提交首行必须以版本号开头**，例如
#   V2.0.2 封面圆角对齐 + 进场更顺
#   1. 一镜到底起飞首帧圆角改为书架封面当前形状
#   2. 去掉进场"起手回沉"
# 钩子会把它写进 AppScope/app.json5 与 VersionLogData.ets 并 git add 进本笔提交。
#
# ⚠️ 钩子**永不阻塞提交**：脚本异常只打印告警，仍以 0 退出。
# ============================================================================
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "$ROOT" ] && exit 0
SCRIPT="$ROOT/scripts/sync-version.ps1"
[ -f "$SCRIPT" ] || exit 0

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT" "$1" || \
    echo "[sync-version] ⚠️ 同步失败（不影响本次提交），请手动跑 scripts/sync-version.ps1"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT" "$1" || \
    echo "[sync-version] ⚠️ 同步失败（不影响本次提交），请手动跑 scripts/sync-version.ps1"
else
  echo "[sync-version] ⚠️ 找不到 pwsh/powershell，跳过版本与更新日志同步"
fi
exit 0
