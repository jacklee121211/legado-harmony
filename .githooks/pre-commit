#!/bin/sh
# ── pre-commit：自动重建 web 前端产物，避免 rawfile 里的 *_v3.html 与 web/src 脱同步 ──
#
# 背景：手机端 Web 服务直接下发 `entry/src/main/resources/rawfile/*_v3.html`，
# 而它们由 `web/` 真前端工程构建产生。审计（2026-10-06，D2）发现**没有任何自动化**
# 保证两者同步 —— 改了 web/src 忘了构建，用户看到的就是旧页面，且构建日志一切正常。
#
# 做法：提交前若 `web/` 有改动，自动 `node build.mjs` 并把产物 `git add` 进本次提交。
# 任何一步失败都**只警告、不阻断提交**（构建失败不该让人无法提交代码）。
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

[ -d web ] || exit 0
[ -f web/build.mjs ] || exit 0
[ -d web/node_modules ] || { echo "[pre-commit] 跳过 web 重建：web/node_modules 不存在（先 npm i）"; exit 0; }
command -v node >/dev/null 2>&1 || { echo "[pre-commit] 跳过 web 重建：未找到 node"; exit 0; }

if git diff --cached --name-only | grep -q '^web/'; then
  echo "[pre-commit] 检测到 web/ 改动，重建 rawfile 产物…"
  if (cd web && node build.mjs); then
    git add entry/src/main/resources/rawfile/reader_v3.html \
            entry/src/main/resources/rawfile/library_v3.html \
            entry/src/main/resources/rawfile/upload_v3.html 2>/dev/null || true
  else
    echo "[pre-commit] ⚠️ web 构建失败，已跳过（请手动修复后重新提交）"
  fi
fi

exit 0

# ── 隐私闸门（2026-10-19）：禁止把截图/本地验证产物提交进去 ──────────────────────
# 起因：screenshots/ 与 verify/ 里含锁屏/桌面截图（有家人的照片），曾被随全量提交带进
# GitHub 历史，事后只能重写历史+强推才清除。这里在提交前硬拦一道。
# 命中即**阻断提交**（这是少数必须阻断的场景：一旦进历史就要重写历史才能挽回）。
BLOCKED=$(git diff --cached --name-only | grep -E '^(screenshots|verify|\.cache)/' || true)
if [ -n "$BLOCKED" ]; then
  echo ""
  echo "[pre-commit] ✗ 拒绝提交：暂存区里有截图/验证产物（含个人隐私画面）"
  echo "$BLOCKED" | sed 's/^/    /'
  echo "    → 这些目录已在 .gitignore 里；请 git restore --staged <文件> 后重试。"
  echo "    → 验证截图请放到仓库外目录（例如 D:\\Arkts\\3.8.11\\_dsh_shots\\）。"
  echo ""
  exit 1
fi
