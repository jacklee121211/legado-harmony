{
  "app": {
    // ⚠️ 2026-09-23 用户要求：包名 com.legado.app -> com.jk.reader，软件名 -> 喵阅
    //   连带必改：entry/src/main/resources/base/profile/shortcuts_config.json 里两处
    //   wants.bundleName（不同步会让桌面快捷方式失效）。
    //   ⚠️ 签名描述文件(.p7b)是按旧包名签发的 => 改包名后要重新生成签名：
    //      devecocli auth login -> devecocli signature generate --product default
    //      否则安装会报签名/描述文件不匹配。且新包名是一个**全新应用**，旧应用数据不迁移。
    "bundleName": "com.jk.reader",
    "vendor": "example",
    "versionCode": 200,
    "versionName": "2.0.0",
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
